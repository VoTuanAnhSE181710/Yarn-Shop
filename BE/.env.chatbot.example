# Optional Gemini planning for Chatbot and AI Agent.
# Guided flows and explicit Agent tool actions work without these variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Official support contact returned by GET /api/v1/chatbot/admin-contact.
ADMIN_NAME=Yarn Shop Support
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_WORKING_HOURS=08:00-17:30, Monday-Saturday
ADMIN_RESPONSE_TIME=Within business hours
ADMIN_ZALO_URL=
ADMIN_FACEBOOK_URL=
